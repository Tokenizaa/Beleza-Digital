{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beleza-digital",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "main": "src/worker-main.ts",
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "2d4055497d544c6fa05443c9112c4ca0",
      "preview_id": "2302eb8ab8434c509915e02659f76ad2"
    }
  ]
}
