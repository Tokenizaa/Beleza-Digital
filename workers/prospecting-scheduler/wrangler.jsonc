{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "prospecting-scheduler",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-11",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "BROWSERLESS_BASE_URL": "https://production-sfo.browserless.io",
    "PROSPECTING_BATCH_SIZE": "2"
  }
}
